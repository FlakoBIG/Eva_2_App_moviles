<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E0E0E0"
    tools:context=".View_plantita">

    <!-- Contenedor de imagen -->
    <FrameLayout
        android:id="@+id/contenedor_imagen"
        android:layout_width="341dp"
        android:layout_height="267dp"
        android:layout_marginTop="16dp"
        android:background="#C0C0C0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <ImageView
            android:id="@+id/imagen_planta"
            android:layout_width="353dp"
            android:layout_height="271dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cala" />
    </FrameLayout>

    <!-- Contenedor de información -->
    <LinearLayout
        android:id="@+id/contenedor_informacion"
        android:layout_width="333dp"
        android:layout_height="172dp"

        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_imagen"
        app:layout_constraintWidth_percent="0.9">

        <!-- Fila: Nombre de la planta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_shape" />

            <TextView
                android:id="@+id/nombre_planta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre: "
                android:textColor="#000000"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btn_fotos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#32CD32"
                android:text="Fotos"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Fila: Fecha de plantación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_shape" />

            <TextView
                android:id="@+id/texto_fecha_plantacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de plantación: "
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Fila: Nombre real -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_shape" />

            <TextView
                android:id="@+id/nombre_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre real: "
                android:textColor="#000000"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Botones: Guía, Editar y Eliminar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btn_guia"
                android:layout_width="26dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:backgroundTint="#0000FF"
                android:text="Recomendaciones"
                android:textColor="#FFFFFF"
                android:textSize="8sp" />

            <Button
                android:id="@+id/btn_editar"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#32CD32"
                android:text="Editar Planta"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_eliminar_planta"
                android:layout_width="2dp"
                android:layout_height="56dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#FF0000"
                android:text="Eliminar"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Diario de plantación -->
    <LinearLayout
        android:id="@+id/contenedor_diario"
        android:layout_width="334dp"
        android:layout_height="53dp"
        android:layout_marginTop="8dp"
        android:background="#32CD32"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/contenedor_informacion"
        app:layout_constraintWidth_percent="0.9">

        <Button
            android:id="@+id/btn_agregar_entrada"
            android:layout_width="wrap_content"
            android:layout_height="37dp"
            android:backgroundTint="#0000FF"
            android:text="Agregar"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/titulo_diario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Diario de plantación"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

    <Button
        android:id="@+id/ver_diario"
        android:layout_width="334dp"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:text="@string/ver_diario"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.545"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/contenedor_diario" />


</androidx.constraintlayout.widget.ConstraintLayout>
